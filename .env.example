# Server-only Turso / libSQL credentials for the global leaderboard.
# Read by api/scores.js and `npm run db:init`. Never prefix these with VITE_.
# Vite copies VITE_ variables into the browser bundle.
TURSO_DATABASE_URL=libsql://your-database-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
