{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(assets|fonts)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/models/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "functions": {
    "api/scores.js": {
      "includeFiles": "migrations/**"
    },
    "api/challenges.js": {
      "includeFiles": "migrations/**"
    },
    "api/account.js": {
      "includeFiles": "migrations/**"
    },
    "api/transfer.js": {
      "includeFiles": "{migrations/**,static/manifest.webmanifest}"
    },
    "api/push.js": {
      "includeFiles": "migrations/**"
    },
    "api/cron/morning.js": {
      "includeFiles": "migrations/**",
      "maxDuration": 60
    },
    "api/cron/evening.js": {
      "includeFiles": "migrations/**",
      "maxDuration": 60
    },
    "api/admin.js": {
      "includeFiles": "migrations/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/morning",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/evening",
      "schedule": "0 15 * * *"
    }
  ]
}
